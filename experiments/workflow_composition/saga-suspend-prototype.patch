--- /dev/null
+++ b/test/suspend_proto_test.gleam
@@ -0,0 +1,149 @@
+//// PROTOTYPE (scratchpad only): in-memory suspend/resume for Saga.
+
+import gleam/erlang/process.{type Subject}
+import gleam/list
+import gleam/option.{type Option, None, Some}
+import saga
+import saga/execution
+
+pub type Err {
+  Pending
+  Rejected
+  Declined
+}
+
+pub type Msg {
+  Log(String, Subject(Nil))
+  Read(Subject(List(String)))
+  SetAnswer(Bool)
+  GetAnswer(Subject(Option(Bool)))
+}
+
+fn world() -> Subject(Msg) {
+  let ready = process.new_subject()
+  process.spawn(fn() {
+    let s = process.new_subject()
+    process.send(ready, s)
+    loop(s, [], None)
+  })
+  let assert Ok(s) = process.receive(ready, 1000)
+  s
+}
+
+fn loop(s: Subject(Msg), log: List(String), answer: Option(Bool)) -> Nil {
+  case process.receive_forever(s) {
+    Log(e, r) -> {
+      process.send(r, Nil)
+      loop(s, [e, ..log], answer)
+    }
+    Read(r) -> {
+      process.send(r, list.reverse(log))
+      loop(s, log, answer)
+    }
+    SetAnswer(a) -> loop(s, log, Some(a))
+    GetAnswer(r) -> {
+      process.send(r, answer)
+      loop(s, log, answer)
+    }
+  }
+}
+
+fn log(w: Subject(Msg), e: String) -> Nil {
+  process.call(w, 1000, Log(e, _))
+}
+
+fn workflow(w: Subject(Msg), transfer_fails: Bool) {
+  let lookup =
+    saga.step("lookup", fn(n: Int) {
+      log(w, "lookup")
+      Ok(n + 1)
+    })
+    |> saga.undo(fn(_, _) {
+      log(w, "undo lookup")
+      Ok(Nil)
+    })
+  let approve =
+    saga.step("approve", fn(x: Int) {
+      case process.call(w, 1000, GetAnswer) {
+        None -> Error(Pending)
+        Some(True) -> Ok(x)
+        Some(False) -> Error(Rejected)
+      }
+    })
+    |> saga.compensate(max_attempts: 1, with: fn(_, failure, _) {
+      case failure {
+        saga.Returned(Pending) -> saga.Suspend(Pending)
+        saga.Returned(e) -> saga.Abort(e)
+        _ -> saga.Abort(Rejected)
+      }
+    })
+  let transfer =
+    saga.step("transfer", fn(x: Int) {
+      log(w, "transfer")
+      case transfer_fails {
+        True -> Error(Declined)
+        False -> Ok(x * 10)
+      }
+    })
+  let assert Ok(wf) =
+    saga.define("proto", fn(n) {
+      n
+      |> saga.perform(lookup)
+      |> saga.perform(approve)
+      |> saga.perform(transfer)
+    })
+  wf
+}
+
+pub fn suspend_then_resume_skips_completed_steps_test() {
+  let w = world()
+  let wf = workflow(w, False)
+  let assert Ok(execution.Suspended(step, Pending, checkpoint)) =
+    execution.run(wf, 1, execution.config())
+  let assert "approve" = step.name
+  process.send(w, SetAnswer(True))
+  let assert Ok(run) = execution.resume(wf, checkpoint, execution.config())
+  let assert Ok(execution.Completed(20)) = execution.await(run, timeout: 5000)
+  let assert ["lookup", "transfer"] = process.call(w, 1000, Read)
+}
+
+pub fn journal_survives_suspension_test() {
+  let w = world()
+  let wf = workflow(w, True)
+  let assert Ok(execution.Suspended(_, _, checkpoint)) =
+    execution.run(wf, 1, execution.config())
+  process.send(w, SetAnswer(True))
+  let assert Ok(run) = execution.resume(wf, checkpoint, execution.config())
+  let assert Ok(execution.Failed(execution.StepFailed(_, Declined), settlement)) =
+    execution.await(run, timeout: 5000)
+  let assert ["lookup"] = list.map(settlement.undone, fn(a) { a.name })
+  let assert ["lookup", "transfer", "undo lookup"] = process.call(w, 1000, Read)
+}
+
+/// The checkpoint fits only the identical `Workflow` value: a re-defined
+/// workflow (as after any restart or redeploy) cannot resume it.
+pub fn checkpoint_does_not_fit_a_redefined_workflow_test() {
+  let w = world()
+  let assert Ok(execution.Suspended(_, _, checkpoint)) =
+    execution.run(workflow(w, False), 1, execution.config())
+  let assert Error(execution.CheckpointMismatch) =
+    execution.resume(workflow(w, False), checkpoint, execution.config())
+  Nil
+}
+
+/// A checkpoint is a copyable value: resuming it twice runs the pending
+/// effect twice. Durable use needs a revisioned owner (compare-and-set).
+pub fn duplicate_resume_repeats_effects_test() {
+  let w = world()
+  let wf = workflow(w, False)
+  let assert Ok(execution.Suspended(_, _, checkpoint)) =
+    execution.run(wf, 1, execution.config())
+  process.send(w, SetAnswer(True))
+  let assert Ok(first) = execution.resume(wf, checkpoint, execution.config())
+  let assert Ok(execution.Completed(20)) = execution.await(first, timeout: 5000)
+  let assert Ok(second) = execution.resume(wf, checkpoint, execution.config())
+  let assert Ok(execution.Completed(20)) =
+    execution.await(second, timeout: 5000)
+  let assert ["lookup", "transfer", "transfer"] = process.call(w, 1000, Read)
+  Nil
+}
-- 
