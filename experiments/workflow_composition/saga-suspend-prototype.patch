+/// PROTOTYPE: the graph for resuming from a checkpoint (its store already
+/// holds the input), plus the identity of this `define` evaluation. Node ids
+/// are unique integers minted by `define`, so a checkpoint only fits the
+/// very same `Workflow` value, never a re-defined or re-deployed one.
+@internal
+pub fn for_resume(
+  workflow: Workflow(i, o, e, u),
+) -> #(
+  Dict(Int, node.Node(e, u)),
+  List(Int),
+  Dict(Int, List(Int)),
+  Store,
+  fn(Store) -> ffi.RescueResult(o),
+) {
+  let #(nodes, order, dependents, _, fetch) = for_run_graph(workflow)
+  #(nodes, order, dependents, store.new(), fetch)
+}
+
+@internal
+pub fn graph_identity(workflow: Workflow(i, o, e, u)) -> Int {
+  workflow.root_input_id
+}
+
+fn for_run_graph(
+  workflow: Workflow(i, o, e, u),
+) -> #(
+  Dict(Int, node.Node(e, u)),
+  List(Int),
+  Dict(Int, List(Int)),
+  Store,
+  fn(Store) -> ffi.RescueResult(o),
+) {
+  #(
+    workflow.nodes,
+    workflow.order,
+    workflow.dependents,
+    store.new(),
+    fn(current_store) {
+      ffi.rescue(fn() {
+        let produce_output = workflow.fetch_output(current_store)
+        produce_output()
+      })
+    },
+  )
+}
+
 /// The workflow's declared name.
 pub fn name(workflow: Workflow(i, o, e, u)) -> String {
   workflow.name
