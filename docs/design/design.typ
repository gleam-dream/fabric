#behavior(title: "A changed requirement revokes the earlier question", area: "Approval answers", level: "interface")[#given[An action waits for approval and a valid proof matches its stored question.] #when[A fresh policy check requires a different requirement.] #then[The original answer does not authorize the action.]#then[The caller receives the new approval requirement and revision.]]
#behavior(title: "A rejected proof leaves the question answerable", area: "Approval answers", level: "interface")[#given[A pending request has not expired or ended.] #when[An answer supplies a proof from another verifier, requirement or lifetime.] #then[The answer is refused with its typed proof reason.]#then[The pending action is unchanged.]]

