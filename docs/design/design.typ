#entity(id: "fork-member", title: "Fork member", description: [One ordered child request within an activation-scoped occurrence.], kind: "entity", owner: "graph fork scope", lifecycle: "stateful", domain: "graph")[#attribute(id: "phase", name: "Progress", type: "Fork member lifecycle", provenance: "observed", state-type: "fork-phase", state-machine: "fork-lifecycle")[State retains the difference between admission refusal and an admitted child failure.]]
#state-machine(id: "fork-lifecycle", subject: "fork-member", state-field: "phase", state-type: "fork-phase", title: "Member admission and authoritative settlement", initial: "pending", accepting: ("succeeded", "failed", "cancelled", "withdrawn", "rejected"), states: ("pending", "reserved", "active", "uncertain", "succeeded", "failed", "cancelled", "withdrawn", "rejected"), transitions: (("pending", "reserved", "admission committed"), ("pending", "withdrawn", "scope closes before admission"), ("pending", "rejected", "definite admission refusal"), ("reserved", "active", "child creation observed"), ("active", "uncertain", "effect or result unresolved"), ("uncertain", "active", "authoritative recovery"), ("active", "succeeded", "checked result"), ("active", "failed", "definite child failure"), ("active", "cancelled", "settled stop"), ("uncertain", "succeeded", "result reconciled"), ("uncertain", "failed", "failure confirmed"), ("uncertain", "cancelled", "stop confirmed")), caption: [Reserved and active members consume capacity. The structural model keeps terminal observations immutable; contradictory terminal evidence is refused.])
#subsection(title: "Membership and dispatch")[
#answers(title: "Fork occurrence", responsibility: [Fix ordered membership for a pair or bounded map before admitting a member.], interface: [graph.both keeps two native answer types; graph.map takes one child runtime, max_members and concurrency. Each member has a one-based ordinal and private child record.], interactions: [Equal inputs are distinct members. Parent run, activation and ordinal determine stable child identity. Recovery checks fixed membership against saved input and deployed typed binding.], invariants: [Empty map succeeds without children. Oversize map fails before admission. Admission follows order and counts admitted unsettled children, including approval/signal/uncertainty waits, against concurrency.], failure: [Uncertainty blocks new admissions and joining; an unavailable observer never frees capacity. A stopped scope withdraws pending members and keeps admitted cleanup.])

